# === EST-ERA 24/7 Production Environment Template ===
# Copy to .env on your VPS and fill in real secrets (NEVER commit .env to GitHub)

DOMAIN_NAME=est-era.uz

# PostgreSQL
POSTGRES_DB=estera
POSTGRES_USER=estera_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASS

# Redis
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASS

# MinIO / S3 Object Storage (<=40MB proofs)
MINIO_ROOT_USER=estera_storage
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASS

# JWT Security (min 64 random chars)
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_SECRET_KEY

# Payment Mode (TEST or PRODUCTION)
PAYMENT_MODE=TEST
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=

# SMS / OTP (Eskiz.uz or PlayMobile)
SMS_PROVIDER=ESKIZ
SMS_API_EMAIL=
SMS_API_PASSWORD=

# Maps API (Yandex or Google)
MAPS_PROVIDER=YANDEX
MAPS_API_KEY=

# 24/7 Telegram Monitoring Bot Alerts
TG_ALERT_BOT_TOKEN=
TG_ADMIN_CHAT_ID=
